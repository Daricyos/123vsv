<odoo>
    <data noupdate="1">
        <record id="ir_cron_refresh_dotykacka_token" model="ir.cron">
            <field name="name">Refresh Dotykacka API Token</field>
            <field name="model_id" ref="model_dotykacka_cloud_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_all_tokens()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>