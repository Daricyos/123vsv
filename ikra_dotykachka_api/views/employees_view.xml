<odoo>
    <record id="hr_employee_view_form_inherit_ikra" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.ikra</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='coach_id']" position="after">
                <field name="dotykachka_employee_id"/>
            </xpath>
        </field>
    </record>
</odoo>
