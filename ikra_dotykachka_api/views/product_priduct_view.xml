<odoo>
    <record id="product_template_view_form_inherit_ikra" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.ikra</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="dotykachka" string="Dotykachka">
                    <group>
                        <group>
                            <field name="dotykachka_id"/>
                            <field name="dotykachka_category_id"/>
                            <field name="dotykachka_ean"/>
                            <field name="dotykachka_plu"/>
                        </group>
                        <group>
                            <field name="dotykachka_vat"/>
                            <field name="dotykachka_alternative_name"/>
                            <field name="dotykachka_subtitle"/>
                            <field name="dotykachka_units"/>
                            <field name="dotykachka_last_sync"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>