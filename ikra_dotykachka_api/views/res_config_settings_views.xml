<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_dotykacka" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dotykacka</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='keycrm_webhook']" position="inside">
                <block title="Dotykacka Webhook Settings">
                    <setting>
                        <label for="dotykacka_api_token"/>
                        <div class="text-muted">
                            API Token Dotykacka
                        </div>
                        <field name="dotykacka_api_token"/>
                    </setting>
                    <setting>
                        <label for="dotykacka_cloud_id"/>
                        <div class="text-muted">
                            Dotykacka Cloud ID
                        </div>
                        <field name="dotykacka_cloud_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>