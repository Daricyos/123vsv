<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_dotykacka_cloud_config_tree" model="ir.ui.view">
        <field name="name">dotykacka.cloud.config.tree</field>
        <field name="model">dotykacka.cloud.config</field>
        <field name="arch" type="xml">
            <tree string="Dotykacka Clouds">
                <field name="name"/>
                <field name="cloud_id"/>
                <field name="active"/>
                <field name="last_token_refresh"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dotykacka_cloud_config_form" model="ir.ui.view">
        <field name="name">dotykacka.cloud.config.form</field>
        <field name="model">dotykacka.cloud.config</field>
        <field name="arch" type="xml">
            <form string="Dotykacka Cloud Configuration">
                <header>
                    <button name="refresh_token" type="object" string="Refresh Token" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="active" widget="boolean_toggle"/>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g., Main Cloud"/>
                            <field name="cloud_id" placeholder="e.g., 388478152"/>
                        </group>
                        <group>
                            <field name="last_token_refresh" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="API Configuration">
                            <group>
                                <field name="api_user_token" password="True" placeholder="User API token for refresh"/>
                                <field name="api_token" password="True" readonly="1" placeholder="Current access token"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dotykacka_cloud_config" model="ir.actions.act_window">
        <field name="name">Dotykacka Clouds</field>
        <field name="res_model">dotykacka.cloud.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Dotykacka Cloud configuration
            </p>
            <p>
                Configure multiple Dotykacka clouds to sync data from different instances.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_dotykacka_cloud_config"
              name="Dotykacka Clouds"
              parent="base.menu_administration"
              action="action_dotykacka_cloud_config"
              sequence="100"/>
</odoo>
