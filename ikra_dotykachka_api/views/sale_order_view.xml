<odoo>
    <record id="sale_order_view_form_inherit_ikra" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.ikra</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='customer_signature']" position="after">
                <page name="dotykachka" string="Dotykachka">
                    <group>
                        <group>
                            <field name="point_of_sale_dotykacka"/>
                            <field name="order_id_dotykacka"/>
                        </group>
                        <group>
                            <field name="check_number_dotykacka"/>
                            <field name="dotykacka_last_sync"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
